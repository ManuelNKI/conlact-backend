{
  "info": {
    "name": "CONLAC-T - BE-15 y BE-19 - David Barragán",
    "description": "Administración requiere admin_token de Supabase y perfil ADMIN activo. Usar en desarrollo. Crear registros antes de ejecutar solicitudes que usan sus IDs. Descuento/reposición aplican cada petición válida. No incluye credenciales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "association_id",
      "value": "a0000000-0000-0000-0000-000000000001"
    },
    {
      "key": "category_id",
      "value": "c0000000-0000-0000-0000-000000000001"
    },
    {
      "key": "testimonial_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "variant_id",
      "value": ""
    },
    {
      "key": "variant_version",
      "value": "0"
    }
  ],
