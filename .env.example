# ==============================================================================
# CONLAC-T Backend - Variables de Entorno Locales
# ==============================================================================
# Copia este archivo con el nombre .env en esta misma carpeta y asigna tus valores:
#   cp .env.example .env
#
# NOTA: El archivo .env se encuentra en .gitignore y NO se subirá a Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# URL de tu proyecto en Supabase (ej: https://xyzcompany.supabase.co)
SUPABASE_URL=https://tu-project-ref.supabase.co

# Clave Secreta API de Supabase (Secret Key con prefijo sb_sec_...)
# Utilizada por el backend para administrar buckets y saltarse RLS de forma segura
SUPABASE_SERVICE_ROLE_KEY=sb_sec_tu_secret_key_aqui

# Clave Pública JWT de Supabase (Algoritmo ECC P-256 / ES256)
# Puedes colocar la clave pública PEM completa o el contenido Base64 de Supabase
SUPABASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...\n-----END PUBLIC KEY-----"

# (Opcional) Emisor de tokens JWT de Supabase
SUPABASE_JWT_ISSUER=https://tu-project-ref.supabase.co/auth/v1

# (Opcional) JWT Secret para tokens simétricos antiguos HMAC-SHA256
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-length

# ------------------------------------------------------------------------------
# Supabase Storage Buckets
# ------------------------------------------------------------------------------
STORAGE_PRODUCT_BUCKET=product-images
STORAGE_RECIPE_BUCKET=recipe-images
STORAGE_PAYMENT_BUCKET=payment-proofs

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
